// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String
  password String
  profile_id              Int?
  PROFILE                 Profile?     @relation(fields: [profile_id], references: [id])
 
}

model Product {
  id    Int     @id @default(autoincrement())
  name  String
  code  String
  creator String
  approver String
  startDate String
  endDate String
  productFamily String
  finalGood String
}

model Profile {
  id                  Int                   @id @default(autoincrement())
  name                String?               @db.VarChar(100)
  status              Int?                  @db.TinyInt
  identifier          String?               @db.VarChar(100)
  code                Int?
  updated_at          DateTime?             @db.DateTime()
  USER                User[]
  Profile_Transaction Profile_Transaction[]
}

model Profile_Transaction {
  id             Int          @id @default(autoincrement())
  profile_id     Int?
  transaction_id Int?
  PROFILE        Profile?     @relation(fields: [profile_id], references: [id], map: "fk_PROFILE_TRANSACTION_PROFILE")
  TRANSACTION    Transaction? @relation(fields: [transaction_id], references: [id], map: "fk_PROFILE_TRANSACTION_TRANSACTION")

  @@index([profile_id], map: "fk_PROFILE_TRANSACTION_PROFILE")
  @@index([transaction_id], map: "fk_PROFILE_TRANSACTION_TRANSACTION")
}
model Transaction {
  id                  Int                   @id @default(autoincrement())
  number              Decimal?              @db.Decimal(10, 0)
  status              Int?                  @db.TinyInt
  Profile_Transaction Profile_Transaction[]
}